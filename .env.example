# Baton Environment Configuration

# Application secret key for session signatures and CSRF protection
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# Default password for seeded demo accounts (Divya, Meera, Arjun, Sameer)
DEMO_PASSWORD=demo1234

# Gemini API key for live LLM extraction runs
GEMINI_API_KEY=

# Master kill-switch for live extraction (1 = enabled, 0 = disabled)
LIVE_ENABLED=1

# Maximum provider LLM calls allowed across all users per day (e.g., 50)
LIVE_DAILY_CALL_CAP=50

# Maximum number of registered non-demo user accounts allowed
MAX_USERS=100

# Daily live extraction runs permitted per user account
RUNS_PER_USER_PER_DAY=3

# Directory where live extraction results are cached across runs
RUNTIME_CACHE_DIR=./runtime_cache

# Database file location (defaults to baton.db in current working directory)
BATON_DB=baton.db

# Number of trusted reverse proxy hops from the right for X-Forwarded-For IP resolution
TRUSTED_PROXY_HOPS=1
